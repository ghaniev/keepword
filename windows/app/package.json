{
  "name": "meetnotes",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "prepare-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-runtime.ps1",
    "prepare-media": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-media.ps1",
    "prepare-llama": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-llama.ps1",
    "prepare-native": "npm run prepare-runtime && npm run prepare-media && npm run prepare-llama && npm run prepare-notices",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "tauri": "tauri",
    "prepare-notices": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-notices.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.5.0",
    "ical.js": "2.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.5.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
