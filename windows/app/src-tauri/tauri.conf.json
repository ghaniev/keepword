{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepword",
  "version": "0.1.1",
  "identifier": "com.meetnotes.app",
  "build": {
    "beforeDevCommand": "npm run prepare-native && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keepword",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/onnxruntime": "onnxruntime",
      "binaries/media": "media",
      "binaries/llama": "llama",
      "../../THIRD_PARTY.md": "THIRD_PARTY.md",
      "binaries/notices": "notices"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
